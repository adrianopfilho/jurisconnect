# ---------------------------------------------------------------------------
# JurisConnect — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite .env.local nem segredos reais.
# Valores do ambiente local: rode `pnpm db:start` (ou `supabase status`).
# ---------------------------------------------------------------------------

# URL pública da aplicação (redirects de e-mail e links do portal)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — valores públicos (seguros no navegador; a proteção dos dados é feita por RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SEGREDO. Somente servidor (Server Actions / Route Handlers / Edge Functions).
# Ignora RLS. Nunca usar com prefixo NEXT_PUBLIC_ nem em código de client.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (convites e avisos de segurança) — SMTP.
# Local: Mailpit do Supabase (interface em http://127.0.0.1:54324).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JurisConnect <nao-responda@jurisconnect.local>"
