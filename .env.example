# ---------------------------------------------------------------------------
# JurisConnect — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite .env.local nem segredos reais.
# Valores do ambiente local: rode `pnpm db:start` (ou `supabase status`).
# ---------------------------------------------------------------------------

# Modo protótipo: navegação com dados fictícios, SEM Supabase (não precisa de
# nenhuma outra variável). Use só em ambientes de demonstração. Com "true", o
# sistema real fica inacessível e a área /prototipo passa a existir.
NEXT_PUBLIC_PROTOTYPE=false

# URL pública da aplicação (redirects de e-mail e links do portal)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — valores públicos (seguros no navegador; a proteção dos dados é feita por RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SEGREDO. Somente servidor (Server Actions / Route Handlers / Edge Functions).
# Ignora RLS. Nunca usar com prefixo NEXT_PUBLIC_ nem em código de client.
SUPABASE_SERVICE_ROLE_KEY=

# IP do cliente (bloqueio de login e rate limiting). Na Vercel é usado sempre o
# x-real-ip, calculado pelo proxy da Vercel. Em outra hospedagem, informe o header
# que o SEU proxy reverso define e sobrescreve; sem isso, nenhum header é aceito
# (o cliente poderia forjá-lo) e o bloqueio passa a valer só por e-mail.
TRUSTED_IP_HEADER=

# E-mail transacional (convites e avisos de segurança) — SMTP.
# Local: Mailpit do Supabase (interface em http://127.0.0.1:54324).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JurisConnect <nao-responda@jurisconnect.local>"
